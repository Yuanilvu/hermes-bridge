# ─── Hermes Bridge configuration ──────────────────────────────────────────
# Copy to .env and fill in your values.

# Bridge server settings
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8199
BRIDGE_API_KEY=hermes-local-2026

# LLM backend (9router or direct provider API)
NINE_ROUTER_URL=http://localhost:20128

# Obsidian vault path
VAULT_PATH=/home/yuan/hermes-workspace

# GitHub repo (for auto-push / version tracking)
GITHUB_OWNER=Yuanilvu
GITHUB_REPO=hermes-bridge
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Desktop fallback values (auto-discovered via cua-driver/xdotool if unset)
HERMES_DESKTOP_PID=5540
HERMES_GUARD_WINDOW_ID=4194314
