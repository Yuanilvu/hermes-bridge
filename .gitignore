# Environment — exclude actual .env but keep example
.env
.env.local
.env.production
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Runtime
*.pid
*.lock

# Config with secrets (general deny)
config/providers.txt
config/*.toml

# Allow example configs
!config/settings.example.toml
!config/providers.example.txt
