[Unit]
Description=Hermes Bridge — Local LLM proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yuan
WorkingDirectory=/home/yuan/hermes-bridge
Environment=PATH=/home/yuan/hermes-bridge/.venv/bin:/usr/local/bin:/usr/bin
ExecStartPre=/bin/bash -c 'ls /home/yuan/hermes-bridge/launcher.sh'
ExecStart=/bin/bash /home/yuan/hermes-bridge/launcher.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
